# Secrets. The API keys in these files are live: a Supabase service-role
# key that bypasses every access rule in the database, a Gmail app
# password, and two metered Google/OpenRouteService keys. client/ and
# server/ ignore their own .env as well — this is the backstop that
# catches one added anywhere else in the project.
.env
.env.*
!.env.example

# Dependencies and build output, restored with `npm install` / `npm run build`.
node_modules/
dist/
dist-ssr/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.swp
