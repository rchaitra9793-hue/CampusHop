# CampusHop web app — copy to .env and fill in.
#
# Everything here ships in the JavaScript bundle. Nothing secret belongs
# in this file.

# Sign-in only. All data access goes through the API server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the API server lives.
VITE_API_URL=http://localhost:5000

# Google Maps JavaScript API — drawing maps, nothing else. It has no
# server-side mode, so this key is in the bundle by necessity; restrict
# it by HTTP referrer in the Google Cloud console.
VITE_GOOGLE_MAPS_KEY=

# Optional, only for cloud map styling.
# VITE_GOOGLE_MAP_ID=
